<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="CX Hub — Consent and Preferences (L1)" id="id-45811514fcab4f3c982001b1395a0770" version="5.0.0">
  <folder name="Strategy" id="id-c22358add83e4ffd93d516423b11a6dc" type="strategy"/>
  <folder name="Business" id="id-7277369289a246c6b613edc2f38509af" type="business"/>
  <folder name="Application" id="id-7e03d65d3df34dd58762bbedd101c713" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Customer channels" id="id-510f0dfbc2584b5d859751e9477e7a2f">
      <documentation>Web, email and SMS touchpoints that initiate consent or preference activity.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Agent channels" id="id-4dca98d3142c4c9497283c0f5dc5e005">
      <documentation>C3 and Agent CRM. Submit agent-captured consent and preference outcomes.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Campaign systems" id="id-370a6bf301d444f5961903e5d7ce0b88">
      <documentation>Customer and lead engagement platforms issuing outbound communications.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Preference center" id="id-0495e974215149239cda8526a1f59e5d">
      <documentation>Phase 2 only. Sitecore-hosted self-service portal on colonialpenn.com.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Preference APIs" id="id-94181af3c3d646d4abab2c42a5a75877">
      <documentation>Mediates all preference reads and writes. MuleSoft at L2.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Consent receipt" id="id-a928aac0958c4a0d875816a5e4a1da01">
      <documentation>Capture of agent-originated consent outcomes via the existing pattern.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Access token issuance" id="id-3cc9143e41bc4bf899522e18aa6d0c3f">
      <documentation>Phase 2 only. Issues short-lived tokens scoped to a customer party record.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="EODS" id="id-1dfa21a6f3ee410eac2d1028970484f4">
      <documentation>Designated single system of record for consent and preference data.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Party and policy data" id="id-5c5eb6132d504a7884f4bcddf1ca10d9">
      <documentation>Customer master data and related identifiers held in EODS.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Party preference data" id="id-9106267194a54aa2be659f23c0f57a0b">
      <documentation>Consent and preference state. EODS is the system of record.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Token and audit data" id="id-cae2d0d87489435d9557292f04184410">
      <documentation>Phase 2 only. Token and TTL persisted with the party object, plus audit history.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Epsilon CDP" id="id-d702edaa2e774c898a889a0f1a558d63">
      <documentation>Apollo. Identity resolution when CNOPartyID is not available.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Marketing analytics" id="id-85e09eb6a88748b0a2fe8bdb18b36100">
      <documentation>Downstream marketing reads via existing batch ETL into Snowflake.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="OneTrust" id="id-ad240338b96340ffa089772a37720f2f">
      <documentation>Out of scope in the target state. Removal is the driver for this initiative.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-c837dafe3f5f4003b66a6e59f05b70a0" type="technology"/>
  <folder name="Motivation" id="id-f032b39f6a0c4cc79df80fdf4f003ad7" type="motivation">
    <element xsi:type="archimate:Assessment" name="entprs-consentpref-eapi" id="id-c9f58debf0524c9386e0e072e9bb28d4">
      <documentation>Re-point or decommission. Unresolved in the source deck.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="getCnoPartyId null path" id="id-ebf20b0a50044b4f815c3ca8c1a0d972">
      <documentation>Behaviour when Service ID is null is unresolved in the source deck.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Consent receipt future" id="id-320f623ac6f449a489add1c77e685201">
      <documentation>Whether the pattern is still required once self-service exists.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Token and audit ownership" id="id-588b7cac4d03439eb4746e547b7e3dbc">
      <documentation>Deck states token and TTL persist with the party object in EODS.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-da09ccfe47cc453e8b1c26d06af8f838" type="implementation_migration"/>
